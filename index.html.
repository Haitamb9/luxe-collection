<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LUXE Department Store</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#fff;
    color:#222;
}

header{
    background:#fff;
    border-bottom:1px solid #ddd;
    position:sticky;
    top:0;
    z-index:1000;
}

.top-bar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:15px 5%;
    flex-wrap:wrap;
}

.logo{
    font-size:32px;
    font-weight:bold;
}

.search{
    width:350px;
    max-width:100%;
    padding:12px;
    border:1px solid #ccc;
    border-radius:5px;
}

.cart{
    font-size:24px;
}

.navbar{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:25px;
    padding:15px;
}

.navbar a{
    text-decoration:none;
    color:#222;
    font-weight:bold;
}

.sale-banner{
    background:#000;
    color:#fff;
    text-align:center;
    padding:12px;
}

.hero{
    background:url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1600&q=80') center/cover;
    height:550px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    color:white;
}

.hero-content{
    background:rgba(0,0,0,0.6);
    padding:40px;
    border-radius:10px;
}

.hero h1{
    font-size:52px;
    margin-bottom:15px;
}

.hero p{
    font-size:22px;
    margin-bottom:20px;
}

.hero a{
    background:white;
    color:black;
    padding:14px 28px;
    text-decoration:none;
    border-radius:5px;
    font-weight:bold;
}

.container{
    width:90%;
    max-width:1300px;
    margin:auto;
}

.section-title{
    text-align:center;
    margin:50px 0 30px;
    font-size:36px;
}

.categories{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}

.category{
    background:#f4f4f4;
    text-align:center;
    padding:40px;
    font-size:22px;
    font-weight:bold;
}

.products-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:25px;
    margin-bottom:60px;
}

.product-card{
    border:1px solid #e5e5e5;
    border-radius:8px;
    overflow:hidden;
    background:white;
    transition:.3s;
}

.product-card:hover{
    transform:translateY(-5px);
    box-shadow:0 8px 20px rgba(0,0,0,0.1);
}

.product-card img{
    width:100%;
    height:280px;
    object-fit:cover;
}

.product-info{
    padding:15px;
}

.brand{
    color:#777;
    font-size:14px;
}

.product-name{
    font-size:18px;
    font-weight:bold;
    margin:8px 0;
}

.price{
    font-size:22px;
    font-weight:bold;
}

.buy-btn{
    display:block;
    text-align:center;
    text-decoration:none;
    background:black;
    color:white;
    padding:10px;
    border-radius:4px;
    margin-top:12px;
}

footer{
    background:#111;
    color:white;
    text-align:center;
    padding:40px;
    margin-top:50px;
}

@media(max-width:768px){

.hero h1{
    font-size:36px;
}

.search{
    width:100%;
    margin-top:10px;
}

}
</style>

</head>
